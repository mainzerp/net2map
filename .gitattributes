# Default: auto line-ending normalization
* text=auto

# Shell scripts must always use LF (Linux containers)
*.sh text eol=lf

# Dockerfiles use LF
Dockerfile text eol=lf

# Python/JS/JSX use LF
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.css text eol=lf
*.html text eol=lf
*.mako text eol=lf

# Binary files: no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

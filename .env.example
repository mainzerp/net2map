# Backend authentication token. Leave empty to disable auth (LAN-only setups).
SECRET_TOKEN=change_me_in_production

# JWT secret for token-based authentication.
# If not set, falls back to SECRET_TOKEN.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Default admin password for the initial admin user (created by migration 006).
DEFAULT_ADMIN_PASSWORD=changeme

# PostgreSQL password used by both the postgres container and the backend connection string.
POSTGRES_PASSWORD=changeme

# CORS origin — must match the URL you access the frontend from.
CORS_ORIGIN=http://localhost:3000

# Frontend API token (must match SECRET_TOKEN)
VITE_API_TOKEN=change_me_in_production

# Fernet key for encrypting SNMP passwords at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to store passwords unencrypted (not recommended for production).
ENCRYPTION_KEY=

# Redis URL for shared state and Celery task broker.
# Required for multi-worker scaling and background task queue.
# Leave empty to use in-memory state (single-worker mode).
REDIS_URL=redis://localhost:6379/0

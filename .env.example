# Copy this file to .env and fill in values before running docker compose.

# Required: API authentication token.
# WARNING: docker-compose will refuse to start if this is not set.
SECRET_TOKEN=

# Recommended: JWT signing secret (enables full RBAC).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Required: Initial admin user password (created by migration 006).
# WARNING: docker-compose will refuse to start if this is not set.
DEFAULT_ADMIN_PASSWORD=

# Required: PostgreSQL password used by both the postgres container and the backend connection string.
# WARNING: docker-compose will refuse to start if this is not set.
POSTGRES_PASSWORD=

# CORS origin — must match the URL you access the frontend from.
CORS_ORIGIN=http://localhost:3000

# Fernet key for encrypting SNMP passwords at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to store passwords unencrypted (not recommended for production).
ENCRYPTION_KEY=

# Redis URL for shared state and Celery task broker.
# Required for multi-worker scaling and background task queue.
# Leave empty to use in-memory state (single-worker mode).
REDIS_URL=redis://localhost:6379/0

# Redis URL above only matters for bare-metal runs; docker-compose.yml hard-codes
# redis://redis:6379/0 for all containers.

# --- Optional settings (defaults shown; uncomment to change) ----------------

# JWT access-token lifetime in hours.
# JWT_EXPIRY_HOURS=24

# Backend log level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO

# Log one line per HTTP request (method, path, status, duration).
# REQUEST_LOG_ENABLED=false

# Audit log retention in days for the 6-hourly purge task. The app setting
# "audit_retention_days" (Settings UI / PUT /api/v1/settings/audit_retention_days)
# takes precedence when it is a positive integer. <= 0 here disables the purge.
# AUDIT_RETENTION_DAYS=90

# Serve the OpenAPI UI (/docs, /redoc) and schema (/openapi.json), also through
# the frontend on port 3000. API calls from the UI still require a token.
# OPENAPI_ENABLED=true

# uvicorn worker processes for the backend (>1 requires Redis; compose provides it).
# UVICORN_WORKERS=1

# Trusted proxies for X-Forwarded-For (client IPs for rate limiting).
# Restrict to your reverse-proxy CIDR, e.g. 172.16.0.0/12.
# UVICORN_FORWARDED_ALLOW_IPS=*

# GHCR image tag pulled by docker-compose.yml: a release tag such as v3.2.1 to pin
# a version, default "latest" (newest release).
# NET2MAP_VERSION=
